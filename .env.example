# Porta do servidor
PORT=3000

# Provedor de pagamento Pix: mock (teste), tiggerpay ou zuckpay (legado)
PIX_PROVIDER=mock

# TiggerPay: uso exclusivo do backend. Configure PIX_PROVIDER=tiggerpay.
TIGGERPAY_API_KEY=
# No painel TiggerPay, configure o webhook: https://sua-loja/api/webhooks/pix

# Usados pelo MockPixProvider para montar o BR Code de teste.
PIX_NOME_RECEBEDOR=Casa Marisol
PIX_CIDADE_RECEBEDOR=Sao Paulo
PIX_CHAVE=chave-de-teste@casamarisol.com.br

# Credenciais da ZuckPay (Desenvolvedores -> Credenciais API). Necessarias
# apenas quando PIX_PROVIDER=zuckpay.
ZUCKPAY_CLIENT_ID=
ZUCKPAY_CLIENT_SECRET=

# URL publica da loja, enviada como site_url para a TiggerPay.
PUBLIC_BASE_URL=

# Integracao legada ZuckPay: destino urlnoty enviado na criacao do Pix.
# URL do webhook da Dracofy (rastreamento de conversao Meta Ads). Opcional:
# se nao definida, usa a URL padrao do projeto (token pt_4519b7460cba71257c50fe45aca8e57f).
DRACOFY_WEBHOOK_URL=

# Credencial da integracao com o Rastreio Express (uso exclusivo do backend,
# lib/rastreioExpressClient.js). Nunca expor no frontend, HTML, JS publico,
# localStorage/sessionStorage, respostas de API ou logs.
RASTREIO_EXPRESS_API_KEY=
# Manter false durante a preparacao; ativar somente apos validar o contrato da API.
RASTREIO_EXPRESS_ENABLED=false
