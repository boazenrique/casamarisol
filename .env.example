# Porta do servidor
PORT=3000

# Obrigatorio na Vercel: conexao PostgreSQL (ex.: Neon integrado ao projeto).
# Alternativa aceita: POSTGRES_URL. Nunca expor essas URLs no frontend.
DATABASE_URL=

# Provedor Pix: frendz (padrao), zuckpay ou mock.
PIX_PROVIDER=frendz

# Usados pelo MockPixProvider para montar o BR Code de teste.
PIX_NOME_RECEBEDOR=Casa Marisol
PIX_CIDADE_RECEBEDOR=Sao Paulo
PIX_CHAVE=chave-de-teste@casamarisol.com.br

# Credenciais da ZuckPay (Desenvolvedores -> Credenciais API). Necessarias
# apenas quando PIX_PROVIDER=zuckpay.
ZUCKPAY_CLIENT_ID=
ZUCKPAY_CLIENT_SECRET=

# Credencial exclusiva do servidor. Nunca enviar ao navegador ou commitar.
FRENDZ_API_TOKEN=
FRENDZ_PRODUCT_HASH=8ldhilcbed
FRENDZ_OFFER_HASH=y0zsnvpsae

# Token exclusivo desta loja para autenticar POST /api/frendz/webhook/:token
# (cadastrar no painel Frendz). Gere um token aleatorio longo; nunca commitar
# o valor real nem reusar o mesmo token em outra loja.
FRENDZ_WEBHOOK_TOKEN=preencher-depois

# Trackio: eventos de checkout iniciado e pagamento aprovado (uso exclusivo
# do backend). TRACKIO_WEBHOOK_SECRET assina as chamadas com HMAC SHA-256 e
# nunca deve ser enviado ao navegador.
TRACKIO_ORIGIN=https://track-io.site
TRACKIO_STORE_SLUG=casa-marisol
TRACKIO_WEBHOOK_SECRET=preencher-depois

# A Frendz usa o MESMO offer/product hash para os 8 produtos da loja: eles
# nunca identificam qual item foi comprado (servem so de whitelist no
# webhook, nunca para resolver o produto - ver lib/trackio.js). O produto
# real enviado ao Trackio vem do pedido local, mapeado aqui por id do
# catalogo (lib/products.js) -> { codigo, nome exibido ao cliente }. Ajuste
# os codigos conforme cadastrados no Trackio.
TRACKIO_PRODUCTS_JSON={"16069manteiga":{"codigo":"CM-001","nome":"Kit 10 Potes Vidro Hermetico Marmita Fitness Com Tampa Quatro Travas Retangular Anti Vazamento"},"NOVO16069MARGARINA":{"codigo":"CM-002","nome":"Pote Vidro Hermético 1040ml Marmita Tampa Trava Vedação"},"16079fuba":{"codigo":"CM-003","nome":"Conjunto Talheres e Faqueiro Aço Inoxidável 24 Peças Durável Elegante Sofisticado Refeições"},"CONJ-MARINEX-5PC":{"codigo":"CM-004","nome":"Conjunto Marinex Jogo de Travessas 5 (CINCO) peças Variadas em Vidro Temperado próprias P/ Forno"},"CV-336vinagrete":{"codigo":"CM-005","nome":"Pote Hermético Vidro (1 Litro) - Vinagrete"},"KIT-GARRAFA-MYBOX":{"codigo":"CM-006","nome":"Kit 3 Garrafas para Bebidas Decorativa My Box 1 Litro"},"BRINOX-CERAMIC-SMARTPLUS-8PC":{"codigo":"CM-007","nome":"Conj de Panelas 8 Peças Ceramic Life Smart Plus Vanilla - Brinox"},"GAABOR-MULTISLICE-2L-PRETO":{"codigo":"CM-008","nome":"Processador Multislice Gaabor 2 Litros Vidro 4 Lâminas Cor Preto"}}

# URL publica HTTPS da loja. Frendz usa /api/webhooks/frendz nesta URL.
# ZuckPay continua enviando o callback diretamente para DRACOFY_WEBHOOK_URL.
PUBLIC_BASE_URL=https://www.casamarisolshop.com.br

# Destino urlnoty enviado na criacao do Pix: ZuckPay -> Dracofy -> Meta.
# URL do webhook da Dracofy (rastreamento de conversao Meta Ads). Opcional:
# se nao definida, usa a URL padrao do projeto (token pt_4519b7460cba71257c50fe45aca8e57f).
DRACOFY_WEBHOOK_URL=

# Credencial da integracao com o Rastreio Express (uso exclusivo do backend,
# lib/rastreioExpressClient.js). Nunca expor no frontend, HTML, JS publico,
# localStorage/sessionStorage, respostas de API ou logs.
RASTREIO_EXPRESS_API_KEY=
# Manter false durante a preparacao; ativar somente apos validar o contrato da API.
RASTREIO_EXPRESS_ENABLED=false
