<!doctype html>
<html lang="pt-BR">
<head>
  <%- include("partials/head", { titulo: "Pagamento confirmado" }) %>
</head>
<body>
  <%- include("partials/header") %>

  <main class="container">
    <section class="pagina-pagamento pagina-confirmacao">
      <div class="icone-sucesso"><i class="fa-solid fa-circle-check"></i></div>
      <h1>Pagamento confirmado!</h1>
      <p>Pedido <strong><%= pedido.id %></strong> — obrigado pela compra, <%= pedido.cliente?.nome?.split(" ")[0] || "" %>!</p>

      <div class="itens-comprados">
        <% pedido.itens.forEach((item) => { %>
          <div class="item-comprado">
            <img src="<%= item.imagem %>" alt="<%= item.nome %>" />
            <div>
              <strong><%= item.nome %></strong>
              <small><%= item.quantidade %> unidade<%= item.quantidade > 1 ? "s" : "" %></small>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="aviso-rastreio-email">
        <i class="fa-solid fa-envelope-circle-check"></i>
        <div>
          <strong>Enviamos o rastreio do seu pedido para o seu e-mail.</strong>
          <span>Verifique a caixa de entrada de <strong><%= pedido.cliente?.email %></strong> (e a pasta de spam/lixo eletrônico) para acompanhar a entrega.</span>
        </div>
      </div>

      <a href="/" class="btn btn-primario btn-bloco">Voltar para a loja</a>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
